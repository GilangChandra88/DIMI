{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:8000", "http://127.0.0.1:8000/*"]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "shell:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    "shell:allow-open",
    "process:default",
    "process:allow-exit",
    "updater:default"
  ]
}